generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String          @id @default(uuid())
  displayName     String
  // Nullable: pre-auth anonymous rows keep these null forever and simply
  // become unreachable by login — a deliberate "fresh start", not a bug.
  email           String?         @unique
  passwordHash    String?
  emailVerifiedAt DateTime?
  createdAt       DateTime        @default(now())
  sessions        Session[]
  consents        ConsentRecord[]
  authSessions    AuthSession[]
  authTokens      AuthToken[]
}

/** A signed-in browser session — the cookie carries only this row's id. */
model AuthSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  userAgent String?
  ipAddress String?

  @@index([userId])
}

/** Single-use email-verification / password-reset links, keyed by purpose. */
model AuthToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  purpose   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
}

model Stimulus {
  id             String    @id
  theme          String
  subtopic       String
  imagePath      String
  captionFr      String
  culturalLinkFr String
  attribution    String
  licenseName    String
  sourceUrl      String
  // True for a row dropped from the manifest but kept only because a past
  // session still references it — its image file may no longer exist, so it
  // must never be offered to a new session or listed publicly.
  retired        Boolean   @default(false)
  createdAt      DateTime  @default(now())
  sessions       Session[]
}

model Session {
  id                     String              @id @default(uuid())
  userId                 String
  user                   User                @relation(fields: [userId], references: [id])
  stimulusId             String
  stimulus               Stimulus            @relation(fields: [stimulusId], references: [id])
  mode                   String
  status                 String              @default("DRAFT")
  currentPhase           String?
  prepSecondsAllotted    Int                 @default(900)
  presentationSecondsCap Int                 @default(600)
  notepadBullets         Json?
  startedAt              DateTime?
  endedAt                DateTime?
  createdAt              DateTime            @default(now())
  segments               TranscriptSegment[]
  score                  Score?
  consent                ConsentRecord?
  audioFiles             AudioFile[]
}

model TranscriptSegment {
  id            String   @id @default(uuid())
  sessionId     String
  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  phase         String
  speaker       String
  text          String
  startMs       Int
  endMs         Int
  sttConfidence Float?
  createdAt     DateTime @default(now())

  @@index([sessionId, phase])
}

model AudioFile {
  id         String   @id @default(uuid())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  phase      String
  speaker    String
  filePath   String
  format     String   @default("wav")
  durationMs Int
  createdAt  DateTime @default(now())

  @@unique([sessionId, phase, speaker])
}

model Score {
  id             String   @id @default(uuid())
  sessionId      String   @unique
  session        Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  criterionA     Int
  criterionB1    Int
  criterionB2    Int
  criterionC     Int
  total          Int
  rationaleJson  Json
  strengthsJson  Json
  prioritiesJson Json
  drillsJson     Json
  confidenceNote String?
  scoredAt       DateTime @default(now())
}

model ConsentRecord {
  id                        String   @id @default(uuid())
  sessionId                 String   @unique
  session                   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId                    String
  user                      User     @relation(fields: [userId], references: [id])
  consentedAt               DateTime @default(now())
  consentTextVersion        String
  recordingConsent          Boolean
  dataRetentionAcknowledged Boolean
}
