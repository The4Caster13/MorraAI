# --- Database (required) ---
# Pooled (pgbouncer) connection string for the app runtime:
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# OPTIONAL. Direct connection string, used only by `prisma migrate` — migrations
# can't run through a connection pooler. Defaults to DATABASE_URL if unset, which
# is correct for any ordinary (non-pooled) Postgres, including local Docker.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Audio storage (optional) ---
# Leave these unset and session audio is written to storage/ at the repo root,
# which needs no setup. Set them to keep audio in a Supabase bucket instead:
# create a PRIVATE bucket named session-audio, then fill in both values.
# Half-filled templates (anything containing < or >) are treated as unset.
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="<service-role-key — backend only, never expose to frontend>"
SUPABASE_AUDIO_BUCKET="session-audio"
=======
# --- Database: local Postgres (recommended for dev — see README "Setup") ---
# `brew install postgresql@17 && brew services start postgresql@17 && createdb morrai`
# Username must match your OS username (`whoami`) — Homebrew's default cluster
# uses peer auth, and there is no `postgres` role.
DATABASE_URL="postgresql://<your-os-username>@localhost:5432/morrai"
DIRECT_URL="postgresql://<your-os-username>@localhost:5432/morrai"

# --- Database: Supabase (alternative — comment out the local block above) ---
# Pooled (pgbouncer) connection string for the app runtime:
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection string, used only by `prisma migrate`:
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="<service-role-key — backend only, never expose to frontend>"
# SUPABASE_AUDIO_BUCKET="session-audio"

# --- Audio storage ---
# Auto-detects: Supabase if SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set
# above, local disk (storage/audio/, gitignored) otherwise. Override either way:
# STORAGE_MODE="local"
# LOCAL_AUDIO_DIR="storage/audio"
