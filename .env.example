# --- Database (required) ---
# Local Postgres (recommended for dev — no pooler latency, no Docker needed):
#   brew install postgresql@17 && brew services start postgresql@17 && createdb morrai
# Username must match your OS username (`whoami`) — Homebrew's default cluster
# uses peer auth and there is no `postgres` role.
DATABASE_URL="postgresql://<your-os-username>@localhost:5432/morrai"

# OPTIONAL. Direct connection string, used only by `prisma migrate` — migrations
# can't run through a connection pooler. Defaults to DATABASE_URL if unset,
# which is correct for any ordinary (non-pooled) Postgres, including the local
# setup above. Only needed for Supabase, where the pooled and direct hosts differ:
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# To use Supabase instead of local Postgres, set DATABASE_URL to the pooled
# (port 6543, `?pgbouncer=true`) connection string from Connect → Transaction
# pooler, and set DIRECT_URL as above.

# --- Audio storage (optional) ---
# Leave these unset and session audio is written to storage/audio/ at the repo
# root (gitignored) — needs no setup. Set them to keep audio in a Supabase
# bucket instead: create a PRIVATE bucket named session-audio, then fill in
# both values. Half-filled templates (anything containing < or >) are treated
# as unset, so leaving these as-is is the same as leaving them out.
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="<service-role-key — backend only, never expose to frontend>"
SUPABASE_AUDIO_BUCKET="session-audio"
# Force local or Supabase storage explicitly instead of relying on auto-detect:
# STORAGE_MODE="local"
# LOCAL_AUDIO_DIR="storage/audio"

# --- Examiner AI ---
# Leave GEMINI_API_KEY unset to run in mock mode (canned French examiner, fixture scoring).
# GEMINI_API_KEY="<your-gemini-api-key>"
# Live (realtime audio) model. Verified against this project's key via
# `npm run check:gemini`: gemini-3.1-flash-live-preview returned audio at
# 689ms to first byte; gemini-2.5-flash-native-audio-preview-09-2025 no longer
# appears in Google's model list. Fallback if this one is retired:
# gemini-2.5-flash-native-audio-preview-12-2025.
GEMINI_LIVE_MODEL="gemini-3.1-flash-live-preview"
# Text model used only for the post-session rubric scoring call. The 2.5-era
# models (including the "gemini-flash-latest" alias) 404 for this project's
# key ("no longer available to new users") — confirmed directly, not just
# undocumented.
GEMINI_SCORING_MODEL="gemini-3.5-flash"
# Prebuilt Live voice — some Live models transcribe their own speech but
# synthesise no audio until one is named. Options: Kore, Puck, Charon, Aoede,
# Fenrir, Zephyr.
GEMINI_VOICE="Kore"
# Force mock mode even when a key is present:
# EXAMINER_MODE="mock"

# --- Server ---
PORT=3001
# "production" makes the server serve apps/web/dist from its own origin and
# disables cross-origin API access. Leave unset for local development.
# NODE_ENV=production
# Origin allowed to call the API in development (the Vite dev server):
DEV_WEB_ORIGIN="http://localhost:5173"

# --- Public deployment (optional) ---
# Shared password gating session creation. Unset = open (correct for local dev).
# On a public URL this is what stops strangers spending your Gemini budget.
# ACCESS_CODE="pick-something-hard-to-guess"
