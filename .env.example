# --- Database (required) ---
# Pooled (pgbouncer) connection string for the app runtime:
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# OPTIONAL. Direct connection string, used only by `prisma migrate` — migrations
# can't run through a connection pooler. Defaults to DATABASE_URL if unset, which
# is correct for any ordinary (non-pooled) Postgres, including local Docker.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Audio storage (optional) ---
# Leave these unset and session audio is written to storage/ at the repo root,
# which needs no setup. Set them to keep audio in a Supabase bucket instead:
# create a PRIVATE bucket named session-audio, then fill in both values.
# Half-filled templates (anything containing < or >) are treated as unset.
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="<service-role-key — backend only, never expose to frontend>"
SUPABASE_AUDIO_BUCKET="session-audio"

# --- Examiner AI ---
# Leave GEMINI_API_KEY unset to run in mock mode (canned French examiner, fixture scoring).
# GEMINI_API_KEY="<your-gemini-api-key>"
# Live (realtime audio) model. Fallback: gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_LIVE_MODEL="gemini-3.1-flash-live-preview"
# Text model used only for the post-session rubric scoring call.
GEMINI_SCORING_MODEL="gemini-3.5-flash"
# Prebuilt Live voice (Kore, Puck, Charon, Aoede, Fenrir, Zephyr):
GEMINI_VOICE="Kore"
# Force mock mode even when a key is present:
# EXAMINER_MODE="mock"

# --- Server ---
PORT=3001
# "production" makes the server serve apps/web/dist from its own origin and
# disables cross-origin API access. Leave unset for local development.
# NODE_ENV=production
# Origin allowed to call the API in development (the Vite dev server):
DEV_WEB_ORIGIN="http://localhost:5173"
